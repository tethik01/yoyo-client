# Repo lives on Windows but the containers are Linux. Normalise on commit,
# check out native, and force LF for anything that goes into a container.
* text=auto

*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.sql  text eol=lf
Dockerfile text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
