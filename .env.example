# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- MyAIServer (GB10 box) ---------------------------------------------------
# The stable HTTPS endpoint LiteLLM serves over Tailscale.
# Example: https://myaiserver.tailXXXX.ts.net
YOYO_LLM_BASE_URL=https://REPLACE-ME.ts.net/v1
# Use the Tailscale hostname, never the LAN IP — that is a DHCP lease.
# The LiteLLM virtual key issued for this laptop. Give the laptop its OWN key so you
# can revoke it independently and so per-key rate limits mean something.
YOYO_LLM_API_KEY=sk-REPLACE-ME

# --- Local storage -----------------------------------------------------------
# Windows paths are fine here. Keep everything under one root.
YOYO_DATA_DIR=C:\Projects\Yoyo\YoyoClient\data
YOYO_SQLITE_PATH=C:\Projects\Yoyo\YoyoClient\data\yoyo.db

# --- Obsidian vault ----------------------------------------------------------
# Canon per the handoff. Yoyo reads anywhere in it and writes ONLY to a drafts
# subfolder; promoting a draft is you moving the file. Leave unset to disable.
# YOYO_VAULT_PATH=C:\Users\bhavi\Documents\ObsidianVault

# --- Qdrant (Docker Desktop) -------------------------------------------------
YOYO_QDRANT_URL=http://localhost:6333
YOYO_QDRANT_COLLECTION=yoyo_corpus

# --- API ---------------------------------------------------------------------
YOYO_API_HOST=127.0.0.1
YOYO_API_PORT=8081        # 8080 collides with almost everything

# --- Voice (optional) --------------------------------------------------------
# Engines and model size live in yoyo-voice.yaml, not here. Everything runs on this
# laptop: no audio is sent to MyAIServer or anywhere else. Whisper and Piper weights
# cache under data/voice-models/ — never %TEMP%, which Windows cleans out from under
# you. Install with: uv pip install -e ".[voice]"

# --- Mail and calendar (optional) --------------------------------------------
# Accounts live in yoyo-mail.yaml and yoyo-calendar.yaml. Both share ONE OAuth app
# registration — the same Google "Desktop app" client and the same Entra Application
# ID — so set them up in the same sitting. Client secrets go in secrets/ (gitignored);
# refresh tokens cache under data/mail-tokens/ and data/calendar-tokens/, separately so
# revoking one does not revoke the other. Neither directory is encrypted (OQ4).

# --- Behaviour ---------------------------------------------------------------
YOYO_LOG_LEVEL=INFO
# Server-side timeout is 900 s. Anything lower turns slow successes into failures.
YOYO_REQUEST_TIMEOUT=900
